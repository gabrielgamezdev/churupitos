{
  "name": "churupitos",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "check": "npm run check -w apps/web && npm run barrido",
    "barrido": "node ops/barrido-privacidad.mjs --todo",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db"
  },
  "devDependencies": {
    "supabase": "2.120.0"
  }
}
