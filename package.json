{
  "name": "churupitos",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "preview": "npm run preview -w apps/web",
    "check": "npm run check -w apps/web && npm run check -w tools/importer && npm run privacy:scan && npm run costs:check",
    "privacy:scan": "node ops/barrido-privacidad.mjs --todo",
    "costs:check": "node ops/guardia-costos.mjs",
    "import:read": "npm run read -w tools/importer",
    "import:dry-run": "npm run dry-run -w tools/importer",
    "import:load": "npm run load -w tools/importer --",
    "import:dry-run:cloud": "npm run dry-run -w tools/importer -- --cloud",
    "import:load:cloud": "npm run load -w tools/importer -- --cloud",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:test:cloud": "node ops/cloud-db-test.mjs",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --local > apps/web/src/lib/database.types.ts && prettier --write apps/web/src/lib/database.types.ts"
  },
  "devDependencies": {
    "supabase": "2.120.0",
    "wrangler": "4.148.0"
  }
}
