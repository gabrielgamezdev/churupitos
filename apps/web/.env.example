# Copia este archivo como .env.local (no va a git) y rellénalo.
# En local, los dos valores salen de `npx supabase status`. En la nube, del panel
# de Supabase: Project Settings → API. La clave publicable está hecha para ir en
# la app; la secreta NUNCA va aquí (ADR 0004).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
