{
  "name": "@churupitos/importer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "read": "node src/cli.ts read",
    "dry-run": "node src/cli.ts dry-run",
    "typecheck": "tsc",
    "lint": "eslint . && prettier --check .",
